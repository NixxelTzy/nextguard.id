{
  "name": "nextguard",
  "version": "3.0.0",
  "description": "Enterprise-grade L7 web application firewall for Node.js. Zero config — 17 attack detectors, behavioral analysis, and dashboard integration.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/adapters/nextjs.d.ts",
      "import": "./dist/adapters/nextjs.mjs",
      "require": "./dist/adapters/nextjs.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:property": "vitest run test/property",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build",
    "fetch-geoip": "node scripts/fetch-geoip-data.js"
  },
  "keywords": [
    "firewall", "waf", "security", "middleware", "nextjs", "express", "fastify",
    "xss", "sqli", "sql-injection", "ddos", "rate-limiting", "intrusion-detection",
    "honeypot", "tarpit", "bot-detection", "owasp", "csrf", "ssrf", "rce",
    "path-traversal", "prototype-pollution", "request-smuggling", "zero-config"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@maxmind/geoip2-node": "4.2.0",
    "fast-check": "3.19.0",
    "hdr-histogram-js": "3.0.0",
    "jschardet": "3.0.0",
    "lru-cache": "10.2.2",
    "ua-parser-js": "1.0.38",
    "uuid": "9.0.0"
  },
  "devDependencies": {
    "@types/node": "20.12.0",
    "@types/ua-parser-js": "0.7.39",
    "@types/uuid": "9.0.8",
    "@vitest/coverage-v8": "1.6.0",
    "tsup": "8.0.2",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "express": ">=4.0.0",
    "fastify": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "next": { "optional": true },
    "express": { "optional": true },
    "fastify": { "optional": true }
  }
}
