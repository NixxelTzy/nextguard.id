# Upstash Redis (copy from Vercel dashboard or Upstash console)
KV_REST_API_READ_ONLY_TOKEN=
KV_REST_API_TOKEN=
KV_REST_API_URL=
KV_URL=
REDIS_URL=

# SMTP — use any provider (Gmail app password, Resend SMTP, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=NextGuard <noreply@nextguard.dev>

# App base URL
NEXTAUTH_URL=http://localhost:3001
GITHUB_PAT=your-github-personal-access-token
